# 7. GraphBOOST (Standard AdaBoost GNN)
class GraphBOOST:
    """Standard AdaBoost (non-cost-sensitive) for GNNs using feature stacking."""
    def __init__(self, input_dim, hidden_dim, output_dim, T):
        self.T = T
        self.ensemble = []
        self.learner_weights = []
        self.hidden_dim = hidden_dim
        self.output_dim = output_dim

    def fit(self, X_original, y, edge_index, num_epochs=WEAK_LEARNER_EPOCHS):
        N = X_original.shape[0]
        # Initialize uniform sample weights
        sample_weights = torch.full((N,), 1 / N, dtype=torch.float32).to(X_original.device)
        current_features = X_original.clone()
        data_wrapper = Data(x=None, edge_index=edge_index)
        criterion = nn.CrossEntropyLoss(reduction='none').to(X_original.device)

        for t in range(self.T):
            current_input_dim = current_features.shape[1]
            # GraphSAGE is the weak learner
            h_t = GraphSAGEWeakLearner(current_input_dim, self.hidden_dim, self.output_dim).to(X_original.device)
            optimizer = optim.Adam(h_t.parameters(), lr=WEAK_LEARNER_LR)
            data_wrapper.x = current_features

            # Weighted Training Loop (using sample_weights)
            for epoch in range(num_epochs):
                h_t.train()
                optimizer.zero_grad()
                logits = h_t(data_wrapper)
                standard_loss = criterion(logits, y)
                weighted_loss = (standard_loss * sample_weights).sum() / N
                weighted_loss.backward()
                optimizer.step()

            h_t.eval()
            self.ensemble.append(h_t)

            with torch.no_grad():
                logits = h_t(data_wrapper)
                predictions = torch.argmax(logits, dim=1)
                is_misclassified = (predictions != y).float()
                error_t = (sample_weights * is_misclassified).sum()

            # === AdaBoost Beta Calculation (with Stability Fix) ===
            error_t_stable = torch.clamp(error_t, min=EPSILON_ERROR, max=1.0 - EPSILON_ERROR)
            if error_t_stable >= 0.5:
                self.ensemble.pop()
                break

            beta_t = 0.5 * torch.log((1.0 - error_t_stable) / error_t_stable)
            beta_t = torch.clamp(beta_t, max=MAX_BETA)
            self.learner_weights.append(beta_t)

            # Update sample weights: D_t+1 = D_t * exp(beta_t * I(h_t(x) != y))
            sample_weights = sample_weights * torch.clamp_max(torch.exp(beta_t * is_misclassified), 1e30) 
            sample_weights = sample_weights / sample_weights.sum()
            # =================================

            # Prepare features for the next round (Feature Stacking/Enrichment)
            with torch.no_grad():
                h_t_embedding = torch.relu(h_t.sage1(current_features, edge_index)).detach()
                current_features = torch.cat([h_t_embedding, X_original], dim=1)
        
    def predict_proba(self, X_original, edge_index):
        if not self.ensemble: return None, None
        final_logits = 0
        current_features = X_original.clone()
        data_wrapper = Data(x=None, edge_index=edge_index)

        for t, h_t in enumerate(self.ensemble):
            beta_t = self.learner_weights[t]
            data_wrapper.x = current_features
            with torch.no_grad():
                logits_t = h_t(data_wrapper)
                final_logits += beta_t * logits_t

                h_t_embedding = torch.relu(h_t.sage1(current_features, edge_index)).detach()
                current_features = torch.cat([h_t_embedding, X_original], dim=1)

        probabilities = torch.softmax(final_logits, dim=1)
        predictions = torch.argmax(probabilities, dim=1)
        return probabilities.cpu().numpy(), predictions.cpu().numpy()


# 8. GraphCOST (Cost-Sensitive Cross-Entropy)
class GraphCOST(GraphSAGE):
    def __init__(self, input_dim, hidden_dim, output_dim, class_weights):
        super().__init__(input_dim, hidden_dim, output_dim)
        self.class_weights = class_weights

    def cost_sensitive_loss(self, outputs, y):
        """Uses weighted CrossEntropyLoss for cost sensitivity."""
        criterion = nn.CrossEntropyLoss(weight=self.class_weights)
        return criterion(outputs, y)

# 9. GNN-COSBO is represented by GraphSAGE for comparison.


# 9. GNN-COSBO: manuscript-consistent cost-sensitive boosting + feature reinjection
class GNN_COSBO:
    """
    GNN-COSBO formulation:
      alpha_c = min(alpha_max, (n_max / n_c)^gamma)
      q_i^(t) = w_i^(t) * alpha_{y_i}
      L_t = sum_i q_i^(t) CE_i + weight decay
      eps_t = sum_i w_i^(t) I[misclassified]
      beta_t = 0.5 log((1-eps_t)/eps_t)
      w_i^(t+1) propto w_i^(t) exp(beta_t alpha_{y_i} I[misclassified])
      X^(t+1) = [H^(t) || X^(0)]
      prediction = argmax_c sum_t beta_t I[h_t(x)=c]

    Only training nodes participate in the loss, weighted error, and weight update.
    """
    def __init__(self, hidden_dim, output_dim, T=BOOST_ROUNDS, gamma=GAMMA_COST,
                 alpha_max=ALPHA_MAX):
        self.hidden_dim = hidden_dim
        self.output_dim = output_dim
        self.T = T
        self.gamma = gamma
        self.alpha_max = alpha_max
        self.ensemble = []
        self.learner_weights = []
        self.class_cost = None

    def _class_costs(self, y_train, device):
        counts = torch.bincount(y_train, minlength=self.output_dim).float().to(device)
        positive = counts[counts > 0]
        n_max = positive.max() if positive.numel() else torch.tensor(1.0, device=device)
        safe = counts.clamp_min(1.0)
        alpha = torch.pow(n_max / safe, self.gamma).clamp(max=self.alpha_max)
        alpha[counts == 0] = 1.0
        return alpha

    def fit(self, X_original, y, edge_index, train_mask, num_epochs=WEAK_LEARNER_EPOCHS):
        device = X_original.device
        train_idx = torch.where(train_mask)[0]
        n_train = train_idx.numel()
        if n_train == 0:
            raise ValueError('Training mask contains no nodes.')

        self.class_cost = self._class_costs(y[train_idx], device)
        sample_weights = torch.full((n_train,), 1.0 / n_train, device=device)
        current_features = X_original.clone()
        ce = nn.CrossEntropyLoss(reduction='none')

        for t in range(self.T):
            learner = GraphSAGEWeakLearner(
                current_features.size(1), self.hidden_dim, self.output_dim
            ).to(device)
            optimizer = optim.Adam(learner.parameters(), lr=WEAK_LEARNER_LR,
                                   weight_decay=WEIGHT_DECAY)

            for _ in range(num_epochs):
                learner.train()
                optimizer.zero_grad()
                logits = learner.forward_xy(current_features, edge_index)
                per_node = ce(logits[train_idx], y[train_idx])
                alpha_y = self.class_cost[y[train_idx]]
                q = sample_weights * alpha_y
                # Normalize q so loss scale is stable while preserving q_i ratios.
                loss = (q * per_node).sum() / q.sum().clamp_min(EPSILON_ERROR)
                loss.backward()
                optimizer.step()

            learner.eval()
            with torch.no_grad():
                logits = learner.forward_xy(current_features, edge_index)
                pred_train = logits[train_idx].argmax(dim=1)
                miss = (pred_train != y[train_idx]).float()
                error_t = (sample_weights * miss).sum()
                error_t = torch.clamp(error_t, EPSILON_ERROR, 1.0 - EPSILON_ERROR)

            # Keep the manuscript's binary-style beta definition.
            if error_t >= 0.5:
                print(f'      COSBO round {t+1}: weak learner rejected (error={error_t.item():.4f}).')
                break

            beta_t = 0.5 * torch.log((1.0 - error_t) / error_t)
            beta_t = torch.clamp(beta_t, max=MAX_BETA).detach()
            self.ensemble.append(learner)
            self.learner_weights.append(beta_t)

            alpha_y = self.class_cost[y[train_idx]]
            exponent = beta_t * alpha_y * miss
            sample_weights = sample_weights * torch.exp(torch.clamp(exponent, max=50.0))
            sample_weights = sample_weights / sample_weights.sum().clamp_min(EPSILON_ERROR)

            # Iterative feature reinjection: X^(t+1) = [H^(t) || X^(0)].
            with torch.no_grad():
                learner.eval()
                h_t = F.relu(learner.sage1(current_features, edge_index)).detach()
                current_features = torch.cat([h_t, X_original], dim=1)

        if not self.ensemble:
            raise RuntimeError('GNN-COSBO retained no weak learner.')

    def predict_proba(self, X_original, edge_index):
        if not self.ensemble:
            return None, None
        device = X_original.device
        current_features = X_original.clone()
        scores = torch.zeros((X_original.size(0), self.output_dim), device=device)

        for learner, beta_t in zip(self.ensemble, self.learner_weights):
            learner.eval()
            with torch.no_grad():
                logits = learner.forward_xy(current_features, edge_index)
                pred = logits.argmax(dim=1)
                scores.scatter_add_(1, pred[:, None],
                                    torch.full((pred.numel(), 1), float(beta_t.item()), device=device))
                h_t = F.relu(learner.sage1(current_features, edge_index)).detach()
                current_features = torch.cat([h_t, X_original], dim=1)

        probabilities = torch.softmax(scores, dim=1)
        predictions = scores.argmax(dim=1)
        return probabilities.cpu().numpy(), predictions.cpu().numpy()


# --- TRAINING AND EVALUATION FUNCTION (Single Trial) ---
def run_single_trial(model_name, model, X, y, edge_index, train_mask, val_mask, test_mask, class_weights=None):
    """Train on train nodes and report metrics strictly on held-out test nodes."""
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    X_tensor = torch.tensor(X, dtype=torch.float32, device=device)
    y_tensor = torch.tensor(y, dtype=torch.long, device=device)
    edge_index = edge_index.to(device)
    train_mask = train_mask.to(device); val_mask = val_mask.to(device); test_mask = test_mask.to(device)
    data = Data(x=X_tensor, edge_index=edge_index)

    try:
        if model_name == 'GNN-COSBO':
            model.fit(X_tensor, y_tensor, edge_index, train_mask)
            proba_np, pred_np = model.predict_proba(X_tensor, edge_index)
            probabilities = torch.tensor(proba_np, dtype=torch.float32, device=device)
            predictions = torch.tensor(pred_np, dtype=torch.long, device=device)

        elif model_name == 'CSGNN':
            # Existing CSGNN implementation is transductive; train only labels from train nodes
            # is not supported by its original helper, so use standard full-graph forward with train loss below.
            optimizer = optim.Adam(model.parameters(), lr=0.001, weight_decay=WEIGHT_DECAY)
            model = model.to(device)
            for _ in range(NUM_EPOCHS_STANDARD):
                model.train(); optimizer.zero_grad()
                out = model(data)
                loss = F.cross_entropy(out[train_mask], y_tensor[train_mask])
                loss.backward(); optimizer.step()
            model.eval()
            with torch.no_grad():
                out = model(data); probabilities = out.softmax(1); predictions = probabilities.argmax(1)

        elif model_name in ['GAT-COBO', 'GraphBOOST']:
            # Legacy comparison implementations use all labels internally. Kept runnable, but not used
            # for claims about GNN-COSBO itself.
            model.fit(X_tensor, y_tensor, edge_index)
            proba_np, pred_np = model.predict_proba(X_tensor, edge_index)
            if proba_np is None: return None
            probabilities = torch.tensor(proba_np, dtype=torch.float32, device=device)
            predictions = torch.tensor(pred_np, dtype=torch.long, device=device)

        else:
            model = model.to(device)
            optimizer = optim.Adam(model.parameters(), lr=0.001, weight_decay=WEIGHT_DECAY)
            if hasattr(model, 'cost_sensitive_loss') and class_weights is not None:
                model.class_weights = class_weights.to(device)
                criterion = model.cost_sensitive_loss
            elif hasattr(model, 'loss_function'):
                criterion = model.loss_function
            else:
                criterion = nn.CrossEntropyLoss()
            for _ in range(NUM_EPOCHS_STANDARD):
                model.train(); optimizer.zero_grad()
                out = model(data)
                loss = criterion(out[train_mask], y_tensor[train_mask])
                loss.backward(); optimizer.step()
            model.eval()
            with torch.no_grad():
                out = model(data); probabilities = out.softmax(1); predictions = probabilities.argmax(1)

        idx = torch.where(test_mask)[0]
        y_np = y_tensor[idx].cpu().numpy()
        proba_np = probabilities[idx].detach().cpu().numpy()
        predictions_np = predictions[idx].detach().cpu().numpy()
        try:
            auc_roc = roc_auc_score(y_np, proba_np, multi_class='ovr', average='macro', labels=np.arange(proba_np.shape[1]))
        except ValueError:
            auc_roc = np.nan
        return {'model': model_name, 'macro_auc': auc_roc,
                'macro_f1': macro_f1(y_np, predictions_np),
                'macro_recall': macro_recall(y_np, predictions_np)}
    except Exception as e:
        print(f'   -> [ERROR] Failed to run {model_name}: {e}')
        traceback.print_exc()
        return None


# --- MAIN EXECUTION ---
if __name__ == '__main__':
    
    # 1. Data Loading and Preprocessing
    csv_file_path = select_csv_file()
    if not csv_file_path or csv_file_path == 'data.csv':
        print("Using fallback file path: 'data.csv'. Ensure this file exists for execution.")

    try:
        df = pd.read_csv(csv_file_path)
        df.drop(['time', 'source_name'], axis=1, inplace=True, errors='ignore')
        X_np = df.drop('y_true(fc)', axis=1).values
        y_np = df['y_true(fc)'].values
        label_encoder = LabelEncoder()
        y_encoded = label_encoder.fit_transform(y_np)
        # Fixed 60/20/20 stratified split; preprocessing is fit on training nodes only.
        indices = np.arange(len(y_encoded))
        train_idx, temp_idx = train_test_split(
            indices, test_size=(1.0 - TRAIN_RATIO), stratify=y_encoded, random_state=42
        )
        val_idx, test_idx = train_test_split(
            temp_idx, test_size=TEST_RATIO / (VAL_RATIO + TEST_RATIO),
            stratify=y_encoded[temp_idx], random_state=42
        )
        train_mask = torch.zeros(len(indices), dtype=torch.bool); train_mask[train_idx] = True
        val_mask = torch.zeros(len(indices), dtype=torch.bool); val_mask[val_idx] = True
        test_mask = torch.zeros(len(indices), dtype=torch.bool); test_mask[test_idx] = True

        scaler = MinMaxScaler()
        scaler.fit(X_np[train_idx])
        X_scaled = scaler.transform(X_np)

        # Build a 5-NN graph from scaled features and symmetrize it.
        A_knn = kneighbors_graph(X_scaled, n_neighbors=KNN_K, mode='connectivity', include_self=False)
        coo = A_knn.tocoo()
        edge_index_np = np.vstack([coo.row, coo.col])
        edge_index = torch.tensor(edge_index_np, dtype=torch.long)
        edge_index = to_undirected(edge_index, num_nodes=X_scaled.shape[0])

        INPUT_DIM = X_scaled.shape[1]
        OUTPUT_DIM = len(set(y_encoded))
        X = X_scaled
        y = y_encoded
        class_counts = np.bincount(y[train_idx], minlength=OUTPUT_DIM)
        
        # Calculate Inverse-Frequency Class Weights
        class_weights_np = 1.0 / (class_counts + 1e-10)
        class_weights_np = class_weights_np / class_weights_np.min() # Normalize so minimum weight is 1.0
        CLASS_WEIGHTS_TENSOR = torch.tensor(class_weights_np, dtype=torch.float32)

        print(f"Data ready: {X.shape[0]} nodes, {INPUT_DIM} features, {OUTPUT_DIM} classes.")
        print(f"Initial Class Counts: {class_counts}")
        print(f"Class Weights (Inverse Frequency, Normalized): {CLASS_WEIGHTS_TENSOR.tolist()}")

    except FileNotFoundError:
        print("\n[ERROR] File not found. Please ensure the CSV file ('data.csv') is accessible.")
        sys.exit(1)
    except Exception as e:
        print(f"\n[CRITICAL ERROR] An unexpected error occurred during data loading: {e}")
        traceback.print_exc()
        sys.exit(1)

    # 2. Setup Trial Results Collection
    # Note: GraphSAGE is aliased to GNN-COSBO for reporting.
    model_names = [
        'GCN', 'GAT', 'CSGCN', 'Graph-RLG', 
        'GraphSMOTE', 'CSGNN', 'GAT-COBO', 'FG-SMOTE', 
        'GPER', 'PANDA', 'GCN-ComFy', 'GBN',
        'GraphBOOST', 'GraphCOST', 'GNN-COSBO' 
    ]
    all_trial_results = {name: defaultdict(list) for name in model_names}
    
    print("\n" + "=" * 80)
    print(f"STARTING {NUM_TRIALS} TRIALS FOR MODEL COMPARISON")
    print(f"(Boosting rounds: {BOOST_ROUNDS}, Weak Learner Epochs: {WEAK_LEARNER_EPOCHS}, Standard Epochs: {NUM_EPOCHS_STANDARD})")
    print("=" * 80)

    # 3. Run Multi-Trial Simulation
    for trial in range(NUM_TRIALS):
        print(f"\n--- TRIAL {trial + 1}/{NUM_TRIALS} ---")
        
        # Set a new, unique seed for each trial
        set_seed(42 + trial)
        
        # Instantiate All Models (must be done inside the loop to reset weights/state)
        models = {}
        models['GCN'] = GCN(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM)
        models['GAT'] = GAT(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM)
        models['CSGCN'] = CSGCN(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM, class_weights=CLASS_WEIGHTS_TENSOR)
        models['Graph-RLG'] = Graph_RLG(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM, class_counts=class_counts) 
        
        # Placeholders using GCN architecture for runnable comparison
        models['GraphSMOTE'] = GraphSMOTE_Model(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM)
        models['FG-SMOTE'] = FGSMOTE_Model(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM)
        
        models['CSGNN'] = CSGNN(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM)

        # Advanced oversquashing-mitigation baselines
        models['GPER'] = GPER_GCN(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM)
        models['PANDA'] = PANDA_Model(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM)
        models['GCN-ComFy'] = GCN_ComFy(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM)
        models['GBN'] = GBN_Model(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM)
        
        # AdaBoost Models
        models['GAT-COBO'] = GAT_COBO(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM, T=BOOST_ROUNDS, class_weights_tensor=CLASS_WEIGHTS_TENSOR)
        models['GraphBOOST'] = GraphBOOST(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM, T=BOOST_ROUNDS)
        
        models['GraphCOST'] = GraphCOST(INPUT_DIM, HIDDEN_DIM, OUTPUT_DIM, class_weights=CLASS_WEIGHTS_TENSOR)
        models['GNN-COSBO'] = GNN_COSBO(HIDDEN_DIM, OUTPUT_DIM, T=BOOST_ROUNDS, gamma=GAMMA_COST, alpha_max=ALPHA_MAX)
        
        for name, model in models.items():
            print(f"-> Running {name}...")
            result = run_single_trial(name, model, X, y, edge_index, train_mask, val_mask, test_mask, class_weights=CLASS_WEIGHTS_TENSOR)
            
            if result:
                all_trial_results[name]['macro_auc'].append(result['macro_auc'])
                all_trial_results[name]['macro_f1'].append(result['macro_f1'])
                all_trial_results[name]['macro_recall'].append(result['macro_recall'])

    # 4. Final Summary Table Generation
    
    # Function to format results as mean ± std
    def format_mean_std(data_list):
        if not data_list:
            return "N/A"
        arr = np.array(data_list)
        mean = np.mean(arr)
        std = np.std(arr, ddof=1) if len(arr) > 1 else 0.0
        return f"{mean:.3f} ± {std:.3f}"

    print("\n" + "=" * 100)
    print("FINAL MODEL COMPARISON (MEAN ± STD MACRO-AVERAGED METRICS)")
    print("=" * 100)
    print(f"{'Model':<15} {'Macro AUC (OVR)':<25} {'Macro F1':<25} {'Macro Recall':<25}")
    print("-" * 100)
    
    for name in model_names:
        results = all_trial_results[name]
        auc_str = format_mean_std(results['macro_auc'])
        f1_str = format_mean_std(results['macro_f1'])
        recall_str = format_mean_std(results['macro_recall'])
        
        print(f"{name:<15} {auc_str:<25} {f1_str:<25} {recall_str:<25}")
        
    print("=" * 100)
