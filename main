# 4. CSGNN (Adaptive Cost Matrix)
class CSGNN(GraphSAGE):
    """GraphSAGE with Adaptive Cost Matrix Loss (Train loop defined internally)."""
    def compute_cost_matrix(self, y_true, y_pred, num_classes):
        """Constructs cost matrix based on confusion, histogram, and variance."""
        cm = confusion_matrix(y_true, y_pred, labels=np.arange(num_classes))
        hist = np.bincount(y_true, minlength=num_classes)
        scatter = np.var(cm, axis=1)
        # Simplified cost factor logic
        cost = cm + scatter[:, None] + hist[:, None]
        cost = cost / (cost.max() + 1e-9)
        return torch.tensor(cost, dtype=torch.float32)
        
    def train_model(self, data, y, num_epochs=150, lr=0.001):
        """Custom training loop for CSGNN using adaptive cost matrix."""
        optimizer = optim.Adam(self.parameters(), lr=lr)
        criterion = nn.CrossEntropyLoss(reduction='none') 
        num_classes = len(torch.unique(y))

        for epoch in range(num_epochs):
            self.train()
            optimizer.zero_grad()
            out = self.forward(data)
            preds = torch.argmax(out, dim=1)

            cost_mat = self.compute_cost_matrix(y.cpu().numpy(), preds.cpu().numpy(), num_classes).to(out.device)
            standard_loss = criterion(out, y)
            
            # Apply cost factor: Cost is C(true_class, predicted_class)
            cost_factor = cost_mat[y, preds] 
            loss = (standard_loss * cost_factor).mean()

            loss.backward()
            optimizer.step()


# 5. GAT-COBO (Cost-Sensitive AdaBoost GNN)
class GAT_COBO:
    """Graph Attention Network Cost-Sensitive Boosting Model (CS-AdaBoost)."""
    def __init__(self, input_dim, hidden_dim, output_dim, T, class_weights_tensor, heads=4):
        self.T = T
        # Cost-sensitive factor (alpha_cost): uses inverse frequency weights
        self.alpha_cost = class_weights_tensor 
        self.ensemble = []
        self.learner_weights = []
        self.hidden_dim = hidden_dim
        self.output_dim = output_dim
        self.heads = heads
        
    class GATWeakLearner(nn.Module):
        def __init__(self, in_dim, hidden_dim, out_dim, heads):
            super().__init__()
            self.gat1 = GATConv(in_dim, hidden_dim, heads=heads, dropout=0.6)
            self.gat2 = GATConv(hidden_dim * heads, out_dim, heads=1, concat=False, dropout=0.6)

        def forward(self, x, edge_index):
            h = F.elu(self.gat1(x, edge_index))
            out = self.gat2(h, edge_index)
            return out

    def fit(self, X_original, y, edge_index, num_epochs=WEAK_LEARNER_EPOCHS):
        N = X_original.shape[0]
        sample_weights = torch.full((N,), 1 / N, dtype=torch.float32).to(X_original.device)
        current_features = X_original.clone()
        criterion = nn.CrossEntropyLoss(reduction='none').to(X_original.device)

        for t in range(self.T):
            current_input_dim = current_features.shape[1]
            h_t = self.GATWeakLearner(current_input_dim, self.hidden_dim, self.output_dim, self.heads).to(X_original.device)
            optimizer = optim.Adam(h_t.parameters(), lr=WEAK_LEARNER_LR)

            # Weighted Training Loop
            for epoch in range(num_epochs):
                h_t.train()
                optimizer.zero_grad()
                logits = h_t(current_features, edge_index)
                standard_loss = criterion(logits, y)
                # Weighted loss for the weak learner
                weighted_loss = (standard_loss * sample_weights).sum() / N 
                weighted_loss.backward()
                optimizer.step()
            
            h_t.eval()
            self.ensemble.append(h_t)

            with torch.no_grad():
                logits = h_t(current_features, edge_index)
                predictions = torch.argmax(logits, dim=1)
                is_misclassified = (predictions != y).float()
                # Calculate weighted error
                error_t = (sample_weights * is_misclassified).sum()

            # === AdaBoost Beta Calculation (with Stability Fix) ===
            error_t_stable = torch.clamp(error_t, min=EPSILON_ERROR, max=1.0 - EPSILON_ERROR)
            
            if error_t_stable >= 0.5:
                # If error is too high, stop boosting and discard the learner
                self.ensemble.pop() 
                break

            # Calculate learner weight (Beta)
            beta_t = 0.5 * torch.log((1.0 - error_t_stable) / error_t_stable)
            beta_t = torch.clamp(beta_t, max=MAX_BETA) 
            # =================================

            self.learner_weights.append(beta_t)
            
            # === Sample Weight Update (Cost-Sensitive) ===
            alpha_y_v = self.alpha_cost[y] # Cost for misclassifying true class y
            exponent = beta_t * alpha_y_v * is_misclassified 
            
            # Update weights: D_t+1 = D_t * exp(beta_t * alpha_y_v * I(h_t(x) != y))
            sample_weights = sample_weights * torch.clamp_max(torch.exp(exponent), 1e30) 
            sample_weights = sample_weights / sample_weights.sum()
            # =================================

            # Prepare features for the next round (Feature Stacking/Enrichment)
            with torch.no_grad():
                # Extract embeddings from the first layer (or relevant intermediate layer)
                h_t_embedding = F.elu(h_t.gat1(current_features, edge_index)).detach()
                current_features = torch.cat([h_t_embedding, X_original], dim=1)


    def predict_proba(self, X_original, edge_index):
        if not self.ensemble: return None, None
        final_logits = 0
        current_features = X_original.clone()
        for t, h_t in enumerate(self.ensemble):
            beta_t = self.learner_weights[t]
            with torch.no_grad():
                logits_t = h_t(current_features, edge_index)
                final_logits += beta_t * logits_t # Weighted ensemble prediction
                
                # Prepare features for the next round
                h_t_embedding = F.elu(h_t.gat1(current_features, edge_index)).detach()
                current_features = torch.cat([h_t_embedding, X_original], dim=1)
                
        probabilities = torch.softmax(final_logits, dim=1)
        predictions = torch.argmax(probabilities, dim=1)
        return probabilities.cpu().numpy(), predictions.cpu().numpy()


