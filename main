# --- HYPERPARAMETERS & STABILITY FIX ---
HIDDEN_DIM = 128
WEAK_LEARNER_EPOCHS = 50  # epochs per weak learner
WEAK_LEARNER_LR = 0.01
BOOST_ROUNDS = 4  # T; sensitivity analysis selected T=4
KNN_K = 5
NUM_EPOCHS_STANDARD = 250 # Epochs for standard (non-boosting) models
NUM_TRIALS = 5  # five independent runs
EPSILON_ERROR = 1e-10 # Used to prevent division by zero or log(0)
MAX_BETA = 5.0 # Caps the learner weight to prevent overflow (NaN/Inf)
DROPOUT = 0.5
WEIGHT_DECAY = 5e-4
GAMMA_COST = 0.75
ALPHA_MAX = 7.0
TRAIN_RATIO, VAL_RATIO, TEST_RATIO = 0.60, 0.20, 0.20

# --- OVERSQUASHING BASELINE HYPERPARAMETERS ---
PANDA_TOP_FRAC = 0.10          # fraction of highest-centrality nodes to expand
PANDA_EXPANSION = 2            # expanded hidden width multiplier
GPER_ADD_FRAC = 0.05           # fraction of |E| high-resistance non-edges added
GPER_REMOVE_FRAC = 0.02        # fraction of |E| low-resistance edges removed
COMFY_REWIRE_FRAC = 0.05       # fraction of |E| edges considered for ComFy rewiring


# --- UTILITY FUNCTIONS ---
def set_seed(seed):
    """Sets the seed for reproducibility across trials."""
    torch.manual_seed(seed)
    np.random.seed(seed)
    random.seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)

def select_csv_file():
    """Opens a Tkinter file dialog to select a CSV file (Fallback to hardcoded path)."""
    try:
        root = tk.Tk()
        root.withdraw()
        # Ensure Tkinter is initialized and the root is available
        if root.winfo_exists():
            file_path = filedialog.askopenfilename(filetypes=[("CSV files", "*.csv")])
            root.destroy()
            return file_path if file_path else 'data.csv'
        else:
            return 'data.csv'
    except Exception:
        # Fallback to hardcoded path for non-GUI environments
        return 'data.csv'

def macro_recall(y_true, y_pred):
    """Calculates Macro-averaged Recall."""
    return recall_score(y_true, y_pred, average='macro', zero_division=0)

def macro_f1(y_true, y_pred):
    """Calculates Macro-averaged F1-Score."""
    return f1_score(y_true, y_pred, average='macro', zero_division=0)

# --- BASE GNN MODELS (for standard training) ---

class GCN(nn.Module):
    def __init__(self, input_dim, hidden_dim, output_dim):
        super(GCN, self).__init__()
        self.conv1 = GCNConv(input_dim, hidden_dim)
        self.conv2 = GCNConv(hidden_dim, output_dim)

    def forward(self, data):
        x, edge_index = data.x, data.edge_index
        x = F.relu(self.conv1(x, edge_index))
        x = F.dropout(x, p=0.5, training=self.training)
        x = self.conv2(x, edge_index)
        return x

class GAT(nn.Module):
    def __init__(self, input_dim, hidden_dim, output_dim, heads=4):
        super(GAT, self).__init__()
        # The output of the first GATConv is hidden_dim * heads
        self.conv1 = GATConv(input_dim, hidden_dim, heads=heads, dropout=0.6)
        # The input of the second GATConv must match the output of the first
        self.conv2 = GATConv(hidden_dim * heads, output_dim, heads=1, concat=False, dropout=0.6)

    def forward(self, data):
        x, edge_index = data.x, data.edge_index
        x = F.elu(self.conv1(x, edge_index))
        x = self.conv2(x, edge_index)
        return x

class GraphSAGE(nn.Module):
    def __init__(self, input_dim, hidden_dim, output_dim):
        super(GraphSAGE, self).__init__()
        self.sage1 = SAGEConv(input_dim, hidden_dim)
        self.sage2 = SAGEConv(hidden_dim, output_dim)

    def forward(self, data):
        x, edge_index = data.x, data.edge_index
        x = torch.relu(self.sage1(x, edge_index))
        x = self.sage2(x, edge_index)
        return x


class PANDA_Model(nn.Module):
    def __init__(self, input_dim, hidden_dim, output_dim,
                 top_frac=PANDA_TOP_FRAC, expansion=PANDA_EXPANSION):
        super().__init__()
        self.hidden_dim = hidden_dim
        self.expanded_dim = hidden_dim * expansion
        self.top_frac = top_frac

        self.base_conv = SAGEConv(input_dim, hidden_dim)
        self.wide_conv = SAGEConv(input_dim, self.expanded_dim)
        self.wide_to_base = nn.Linear(self.expanded_dim, hidden_dim)
        self.out_conv = SAGEConv(hidden_dim, output_dim)

    @staticmethod
    def _centrality_mask(edge_index, num_nodes, top_frac):
        src, dst = edge_index
        degree = torch.bincount(
            torch.cat([src, dst]), minlength=num_nodes
        ).float()
        k = max(1, int(np.ceil(top_frac * num_nodes)))
        top_idx = torch.topk(degree, k=min(k, num_nodes)).indices
        mask = torch.zeros(num_nodes, dtype=torch.bool, device=edge_index.device)
        mask[top_idx] = True
        return mask

    def forward(self, data):
        x, edge_index = data.x, data.edge_index
        base_h = F.relu(self.base_conv(x, edge_index))
        wide_h = F.relu(self.wide_conv(x, edge_index))
        wide_h = F.relu(self.wide_to_base(wide_h))

        mask = self._centrality_mask(edge_index, x.size(0), self.top_frac)
        h = base_h.clone()
        h[mask] = wide_h[mask]

        h = F.dropout(h, p=0.5, training=self.training)
        return self.out_conv(h, edge_index)


class GBN_Model(nn.Module):
    def __init__(self, input_dim, hidden_dim, output_dim):
        super().__init__()
        self.self1 = nn.Linear(input_dim, hidden_dim)
        self.neigh1 = GCNConv(input_dim, hidden_dim)
        self.self2 = nn.Linear(hidden_dim, output_dim)
        self.neigh2 = GCNConv(hidden_dim, output_dim)
        self.gate_scale = nn.Parameter(torch.tensor(1.0))
        self.gate_bias = nn.Parameter(torch.tensor(0.0))

    def _local_gate(self, edge_index, num_nodes):
        src, dst = edge_index
        deg = torch.bincount(
            torch.cat([src, dst]), minlength=num_nodes
        ).float().clamp_min(1.0)

        # Mean neighbor degree.
        neigh_sum = torch.zeros(num_nodes, device=edge_index.device)
        neigh_cnt = torch.zeros(num_nodes, device=edge_index.device)
        neigh_sum.index_add_(0, dst, deg[src])
        neigh_cnt.index_add_(0, dst, torch.ones_like(dst, dtype=torch.float))
        mean_neigh_deg = neigh_sum / neigh_cnt.clamp_min(1.0)

        contrast = torch.abs(torch.log1p(deg) - torch.log1p(mean_neigh_deg))
        contrast = (contrast - contrast.mean()) / (contrast.std() + 1e-6)
        return torch.sigmoid(self.gate_scale * contrast + self.gate_bias).unsqueeze(1)

    def forward(self, data):
        x, edge_index = data.x, data.edge_index
        gate = self._local_gate(edge_index, x.size(0))

        h_self = self.self1(x)
        h_neigh = self.neigh1(x, edge_index)
        h = F.relu(gate * h_neigh + (1.0 - gate) * h_self)
        h = F.dropout(h, p=0.5, training=self.training)

        out_self = self.self2(h)
        out_neigh = self.neigh2(h, edge_index)
        return gate * out_neigh + (1.0 - gate) * out_self


def _edge_index_to_simple_undirected(edge_index, num_nodes):
    """Return unique undirected edges as (u, v) with u < v."""
    ei = to_undirected(edge_index, num_nodes=num_nodes)
    ei, _ = remove_self_loops(ei)
    pairs = set()
    for u, v in ei.t().detach().cpu().tolist():
        if u != v:
            a, b = (u, v) if u < v else (v, u)
            pairs.add((a, b))
    return pairs


def _pairs_to_edge_index(pairs, device):
    """Convert undirected edge pairs into bidirectional PyG edge_index."""
    if not pairs:
        return torch.empty((2, 0), dtype=torch.long, device=device)
    edges = []
    for u, v in sorted(pairs):
        edges.append((u, v))
        edges.append((v, u))
    return torch.tensor(edges, dtype=torch.long, device=device).t().contiguous()


def gper_rewire(edge_index, num_nodes,
                add_frac=GPER_ADD_FRAC, remove_frac=GPER_REMOVE_FRAC):
    """
    Effective-resistance rewiring inspired by GPER:
      - add high-effective-resistance non-edges;
      - remove low-effective-resistance existing edges.

    The pseudoinverse is feasible for the current small 5G graphs but can be
    expensive for very large graphs.
    """
    device = edge_index.device
    pairs = _edge_index_to_simple_undirected(edge_index, num_nodes)
    if len(pairs) == 0:
        return edge_index

    A = np.zeros((num_nodes, num_nodes), dtype=np.float64)
    for u, v in pairs:
        A[u, v] = 1.0
        A[v, u] = 1.0

    D = np.diag(A.sum(axis=1))
    L = D - A
    # Moore-Penrose pseudoinverse for effective resistance.
    L_plus = np.linalg.pinv(L + np.eye(num_nodes) * 1e-8)

    diag = np.diag(L_plus)
    R = diag[:, None] + diag[None, :] - 2.0 * L_plus

    m = max(1, len(pairs))
    n_add = max(1, int(add_frac * m)) if add_frac > 0 else 0
    n_remove = max(0, int(remove_frac * m))

    # Add high-resistance non-edges.
    candidates_add = []
    for u in range(num_nodes):
        for v in range(u + 1, num_nodes):
            if (u, v) not in pairs:
                candidates_add.append((R[u, v], u, v))
    candidates_add.sort(reverse=True, key=lambda z: z[0])
    for _, u, v in candidates_add[:n_add]:
        pairs.add((u, v))

    # Remove low-resistance edges, while avoiding isolated endpoints.
    if n_remove > 0:
        deg = np.zeros(num_nodes, dtype=int)
        for u, v in pairs:
            deg[u] += 1
            deg[v] += 1
        candidates_remove = sorted(
            [(R[u, v], u, v) for (u, v) in pairs],
            key=lambda z: z[0]
        )
        removed = 0
        for _, u, v in candidates_remove:
            if removed >= n_remove:
                break
            if deg[u] > 1 and deg[v] > 1 and (u, v) in pairs:
                pairs.remove((u, v))
                deg[u] -= 1
                deg[v] -= 1
                removed += 1

    return _pairs_to_edge_index(pairs, device)


def comfy_rewire(x, edge_index, rewire_frac=COMFY_REWIRE_FRAC):
    """
    ComFy-inspired community + feature-similarity rewiring.

    Communities are detected from topology without labels. The routine removes
    low-similarity inter-community edges and adds high-similarity intra-community
    non-edges, preserving the core ComFy intuition while remaining self-contained.
    """
    device = edge_index.device
    num_nodes = x.size(0)
    pairs = _edge_index_to_simple_undirected(edge_index, num_nodes)
    if len(pairs) == 0:
        return edge_index

    G = nx.Graph()
    G.add_nodes_from(range(num_nodes))
    G.add_edges_from(list(pairs))

    try:
        communities = list(nx.community.louvain_communities(G, seed=42))
    except Exception:
        communities = list(nx.community.greedy_modularity_communities(G))

    comm_id = np.zeros(num_nodes, dtype=int)
    for cid, community in enumerate(communities):
        for node in community:
            comm_id[node] = cid

    x_np = x.detach().cpu().numpy().astype(np.float64)
    norms = np.linalg.norm(x_np, axis=1, keepdims=True) + 1e-12
    z = x_np / norms
    sim = z @ z.T

    m = max(1, len(pairs))
    n_rewire = max(1, int(rewire_frac * m))

    # Remove low-similarity inter-community edges.
    removable = [
        (sim[u, v], u, v)
        for (u, v) in pairs
        if comm_id[u] != comm_id[v]
    ]
    removable.sort(key=lambda z_: z_[0])

    removed_edges = []
    deg = np.zeros(num_nodes, dtype=int)
    for u, v in pairs:
        deg[u] += 1
        deg[v] += 1

    for _, u, v in removable:
        if len(removed_edges) >= n_rewire:
            break
        if deg[u] > 1 and deg[v] > 1 and (u, v) in pairs:
            pairs.remove((u, v))
            deg[u] -= 1
            deg[v] -= 1
            removed_edges.append((u, v))

    # Add high-similarity non-edges within the same community.
    add_candidates = []
    for community in communities:
        nodes = list(community)
        for i in range(len(nodes)):
            u = nodes[i]
            for j in range(i + 1, len(nodes)):
                v = nodes[j]
                a, b = (u, v) if u < v else (v, u)
                if (a, b) not in pairs:
                    add_candidates.append((sim[a, b], a, b))
    add_candidates.sort(reverse=True, key=lambda z_: z_[0])

    target_add = max(len(removed_edges), n_rewire)
    for _, u, v in add_candidates[:target_add]:
        pairs.add((u, v))

    return _pairs_to_edge_index(pairs, device)


class GPER_GCN(GCN):
    """
    GCN evaluated on an effective-resistance rewired graph (GPER-style).
    Rewiring is performed once and cached.
    """
    def __init__(self, input_dim, hidden_dim, output_dim):
        super().__init__(input_dim, hidden_dim, output_dim)
        self._rewired_edge_index = None

    def forward(self, data):
        if self._rewired_edge_index is None:
            self._rewired_edge_index = gper_rewire(
                data.edge_index, data.x.size(0)
            )
        x = F.relu(self.conv1(data.x, self._rewired_edge_index))
        x = F.dropout(x, p=0.5, training=self.training)
        return self.conv2(x, self._rewired_edge_index)


class GCN_ComFy(GCN):
    """
    GCN evaluated on a community/feature-similarity rewired graph (ComFy-style).
    Rewiring is performed once and cached.
    """
    def __init__(self, input_dim, hidden_dim, output_dim):
        super().__init__(input_dim, hidden_dim, output_dim)
        self._rewired_edge_index = None

    def forward(self, data):
        if self._rewired_edge_index is None:
            self._rewired_edge_index = comfy_rewire(
                data.x, data.edge_index
            )
        x = F.relu(self.conv1(data.x, self._rewired_edge_index))
        x = F.dropout(x, p=0.5, training=self.training)
        return self.conv2(x, self._rewired_edge_index)

# --- GraphSAGE Weak Learner (for boosting models) ---
class GraphSAGEWeakLearner(nn.Module):
    """Two-layer GraphSAGE weak learner with an explicit hidden embedding."""
    def __init__(self, input_dim, hidden_dim, output_dim):
        super().__init__()
        self.sage1 = SAGEConv(input_dim, hidden_dim)
        self.sage2 = SAGEConv(hidden_dim, output_dim)

    def encode(self, x, edge_index):
        h = F.relu(self.sage1(x, edge_index))
        h = F.dropout(h, p=DROPOUT, training=self.training)
        return h

    def forward_xy(self, x, edge_index):
        h = self.encode(x, edge_index)
        return self.sage2(h, edge_index)

    def forward(self, data):
        return self.forward_xy(data.x, data.edge_index)


# --- COST-SENSITIVE AND BOOSTING MODELS ---

# 1. CSGCN (Cost-Sensitive GCN - Weighted Cross-Entropy)
class CSGCN(GCN):
    def __init__(self, input_dim, hidden_dim, output_dim, class_weights):
        super().__init__(input_dim, hidden_dim, output_dim)
        self.class_weights = class_weights

    def cost_sensitive_loss(self, outputs, y):
        """Uses weighted CrossEntropyLoss for cost sensitivity."""
        criterion = nn.CrossEntropyLoss(weight=self.class_weights)
        return criterion(outputs, y)

# 2. Graph-RLG (Representation Learning Guided GNN - Class-balanced Loss)
class Graph_RLG(GCN):
    """Graph-RLG: Representation Learning Guided GNN using Effective Number of Samples."""
    def __init__(self, input_dim, hidden_dim, output_dim, class_counts, beta=0.9999):
        super().__init__(input_dim, hidden_dim, output_dim)
        self.beta = beta
        self.register_buffer('effective_class_weights', self._compute_effective_weights(class_counts))

    def _compute_effective_weights(self, class_counts):
        class_counts = torch.tensor(class_counts, dtype=torch.float32)
        effective_num = 1.0 - torch.pow(self.beta, class_counts)
        # Calculate weights, ensuring stability
        weights = (1.0 - self.beta) / (effective_num + EPSILON_ERROR)
        # Normalize weights
        weights = weights / weights.sum() * len(class_counts)
        return weights

    def loss_function(self, outputs, y):
        """Applies effective number of samples weighting."""
        criterion = nn.CrossEntropyLoss(weight=self.effective_class_weights)
        return criterion(outputs, y)

