import os
import json
import random
import numpy as np
import pandas as pd
import scipy.sparse as sp
import torch
import dgl

from sklearn.preprocessing import MinMaxScaler, LabelEncoder
from sklearn.model_selection import train_test_split
from sklearn.neighbors import kneighbors_graph
from dgl.data import DGLDataset
from dgl.data.utils import save_graphs, save_info

DATA_DIR = "./data/"
CSV_FILE = "data.csv"
LABEL_COLUMN = "y_true(fc)"

DROP_COLUMNS = [
    "time",
    "source_name",
]

KNN_K = 5

TRAIN_RATIO = 0.60
VAL_RATIO = 0.20
TEST_RATIO = 0.20

RANDOM_SEED = 42
GRAPH_FILE = "GNN_COSBO_5G.bin"
INFO_FILE = "GNN_COSBO_5G.pkl"
METADATA_FILE = "GNN_COSBO_metadata.json"

def set_seed(seed=42):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)

    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)

def create_stratified_masks(
    labels,
    train_ratio=0.60,
    val_ratio=0.20,
    test_ratio=0.20,
    random_state=42,
):

    assert np.isclose(
        train_ratio + val_ratio + test_ratio, 1.0
    ), "Split ratios must sum to 1."

    labels = np.asarray(labels)
    indices = np.arange(len(labels))
    train_idx, temp_idx = train_test_split(
        indices,
        test_size=(val_ratio + test_ratio),
        stratify=labels,
        random_state=random_state,
    )
    relative_test_ratio = (
        test_ratio / (val_ratio + test_ratio)
    )

    val_idx, test_idx = train_test_split(
        temp_idx,
        test_size=relative_test_ratio,
        stratify=labels[temp_idx],
        random_state=random_state,
    )

    n_nodes = len(labels)

    train_mask = torch.zeros(
        n_nodes,
        dtype=torch.bool,
    )

    val_mask = torch.zeros(
        n_nodes,
        dtype=torch.bool,
    )

    test_mask = torch.zeros(
        n_nodes,
        dtype=torch.bool,
    )

    train_mask[train_idx] = True
    val_mask[val_idx] = True
    test_mask[test_idx] = True

    return (
        train_idx,
        val_idx,
        test_idx,
        train_mask,
        val_mask,
        test_mask,
    )

def preprocess_features(
    X,
    train_idx,
):
   
    scaler = MinMaxScaler()
    scaler.fit(X[train_idx])
    X_scaled = scaler.transform(X)
    return X_scaled.astype(np.float32), scaler

def build_knn_graph(
    features,
    k=5,
):

    n_nodes = features.shape[0]
    if n_nodes <= 1:
        raise ValueError(
            "At least two nodes are required to construct a graph."
        )
    actual_k = min(k, n_nodes - 1)

    print(
        f"Constructing {actual_k}-NN graph "
        f"from {n_nodes} nodes..."
    )
    adjacency = kneighbors_graph(
        features,
        n_neighbors=actual_k,
        mode="connectivity",
        include_self=False,
    )
    adjacency = adjacency.maximum(
        adjacency.T
    )

    adjacency.setdiag(0)
    adjacency.eliminate_zeros()
    adjacency = adjacency.tocoo()

    src = torch.tensor(
        adjacency.row,
        dtype=torch.int64,
    )
    dst = torch.tensor(
        adjacency.col,
        dtype=torch.int64,
    )
    graph = dgl.graph(
        (src, dst),
        num_nodes=n_nodes,
    )
    graph = dgl.remove_self_loop(graph)

    # Add one self-loop per node
    graph = dgl.add_self_loop(graph)
    return graph

def print_class_distribution(
    labels,
    label_names,
    indices,
    split_name,
):
  
    split_labels = labels[indices]

    unique, counts = np.unique(
        split_labels,
        return_counts=True,
    )

    print(
        f"\n{split_name} class distribution"
    )
    print("-" * 60)
    for class_id, count in zip(
        unique,
        counts,
    ):
        class_name = label_names[class_id]
        print(
            f"Class {class_id:2d} "
            f"({class_name}): {count}"
        )

class GNNCOSBODataset(DGLDataset):
    def __init__(
        self,
        csv_path=None,
        k=KNN_K,
        random_seed=RANDOM_SEED,
    ):
        self.csv_path = (
            csv_path
            if csv_path is not None
            else os.path.join(
                DATA_DIR,
                CSV_FILE,
            )
        )
        self.k = k
        self.random_seed = random_seed
        self.graph = None
        self.labels = None
        self.label_encoder = None
        self.scaler = None
        self._num_classes = None
        super().__init__(
            name="gnn_cosbo_5g"
        )
    def process(self):

        set_seed(
            self.random_seed
        )
        print(
            "\n"
            + "=" * 70
        )

        print(
        )

        print(
            "=" * 70
        )
        print(
            f"\nLoading dataset:\n"
            f"{self.csv_path}"
        )
        df = pd.read_csv(
            self.csv_path
        )
        print(
            f"\nOriginal dataset shape: "
            f"{df.shape}"
        )

        if LABEL_COLUMN not in df.columns:
            raise ValueError(
                f"Label column '{LABEL_COLUMN}' "
                f"was not found in the CSV file."
            )

        missing_labels = (
            df[LABEL_COLUMN]
            .isna()
            .sum()
        )

        if missing_labels > 0:
            print(
                f"Removing {missing_labels} "
                f"rows with missing labels."
            )
            df = (
                df
                .dropna(
                    subset=[LABEL_COLUMN]
                )
                .reset_index(drop=True)
            )

        raw_labels = (
            df[LABEL_COLUMN]
            .astype(str)
            .values
        )
        self.label_encoder = (
            LabelEncoder()
        )

        labels = (
            self.label_encoder
            .fit_transform(
                raw_labels
            )
        )
        labels = labels.astype(
            np.int64
        )
        self.labels = torch.tensor(
            labels,
            dtype=torch.long,
        )
        self._num_classes = len(
            self.label_encoder.classes_
        )
        print(
            f"\nNumber of classes: "
            f"{self._num_classes}"
        )
        print(
            "\nLabel mapping:"
        )

        for class_id, name in enumerate(
            self.label_encoder.classes_
        ):

            print(
                f"  {class_id:2d} -> {name}"
            )

        columns_to_remove = (
            DROP_COLUMNS
            + [LABEL_COLUMN]
        )
        feature_df = df.drop(
            columns=columns_to_remove,
            errors="ignore",
        )
        feature_df = (
            feature_df
            .apply(
                pd.to_numeric,
                errors="coerce",
            )
        )
        feature_df.replace(
            [np.inf, -np.inf],
            np.nan,
            inplace=True,
        )
        medians = (
            feature_df
            .median(axis=0)
        )
        feature_df = (
            feature_df
            .fillna(medians)
        )
        all_nan_columns = (
            feature_df
            .columns[
                feature_df
                .isna()
                .all()
            ]
            .tolist()
        )

        if all_nan_columns:
            print(
                "\nRemoving completely empty "
                f"features: {len(all_nan_columns)}"
            )
            feature_df.drop(
                columns=all_nan_columns,
                inplace=True,
            )
        feature_df = (
            feature_df
            .fillna(0.0)
        )
        X = feature_df.values.astype(
            np.float32
        )
        print(
            f"\nNumber of nodes: "
            f"{X.shape[0]}"
        )
        print(
            f"Number of telemetry features: "
            f"{X.shape[1]}"
        )

        (
            train_idx,
            val_idx,
            test_idx,
            train_mask,
            val_mask,
            test_mask,
        ) = create_stratified_masks(
            labels,
            train_ratio=TRAIN_RATIO,
            val_ratio=VAL_RATIO,
            test_ratio=TEST_RATIO,
            random_state=self.random_seed,
        )
        print(
            "\nDataset split:"
        )
        print(
            f"Training   : "
            f"{len(train_idx)} "
            f"({len(train_idx)/len(labels):.2%})"
        )
        print(
            f"Validation : "
            f"{len(val_idx)} "
            f"({len(val_idx)/len(labels):.2%})"
        )
        print(
            f"Testing    : "
            f"{len(test_idx)} "
            f"({len(test_idx)/len(labels):.2%})"
        )
        X_scaled, self.scaler = (
            preprocess_features(
                X,
                train_idx,
            )
        )

        node_features = torch.tensor(
            X_scaled,
            dtype=torch.float32,
        )
   

        self.graph = build_knn_graph(
            X_scaled,
            k=self.k,
        )

        self.graph.ndata[
            "feat"
        ] = node_features
        self.graph.ndata[
            "label"
        ] = self.labels
        self.graph.ndata[
            "train_mask"
        ] = train_mask
        self.graph.ndata[
            "val_mask"
        ] = val_mask
        self.graph.ndata[
            "test_mask"
        ] = test_mask
       
        print(
            "\nGraph statistics:"
        )
        print(
            f"Nodes    : "
            f"{self.graph.num_nodes()}"
        )
        print(
            f"Edges    : "
            f"{self.graph.num_edges()}"
        )
        print(
            f"Features : "
            f"{node_features.shape[1]}"
        )
        print(
            f"Classes  : "
            f"{self._num_classes}"
        )
        print_class_distribution(
            labels,
            self.label_encoder.classes_,
            train_idx,
            "Training",
        )
        print_class_distribution(
            labels,
            self.label_encoder.classes_,
            val_idx,
            "Validation",
        )
        print_class_distribution(
            labels,
            self.label_encoder.classes_,
            test_idx,
            "Testing",
        )
       
        train_class_counts = np.bincount(
            labels[train_idx],
            minlength=self._num_classes,
        )
        print(
            "\nTraining class counts:"
        )
        print(
            train_class_counts
        )

       
        os.makedirs(
            DATA_DIR,
            exist_ok=True,
        )
        graph_path = os.path.join(
            DATA_DIR,
            GRAPH_FILE,
        )
        info_path = os.path.join(
            DATA_DIR,
            INFO_FILE,
        )
        metadata_path = os.path.join(
            DATA_DIR,
            METADATA_FILE,
        )
        save_graphs(
            graph_path,
            [self.graph],
            {
                "labels": self.labels
            },
        )

        save_info(
            info_path,
            {
                "num_classes":
                    self._num_classes,
                "num_features":
                    X_scaled.shape[1],
                "knn_k":
                    self.k,
                "train_size":
                    len(train_idx),
                "val_size":
                    len(val_idx),
                "test_size":
                    len(test_idx),
                "train_class_counts":
                    train_class_counts.tolist(),
                "random_seed":
                    self.random_seed,
            },
        )

     
        metadata = {
            "dataset":
                "5G Core Network Failure Classification",
            "model":
                "GNN-COSBO",
            "num_nodes":
                int(X_scaled.shape[0]),
            "num_features":
                int(X_scaled.shape[1]),
            "num_classes":
                int(self._num_classes),
            "knn_k":
                int(self.k),
            "split": {
                "train": TRAIN_RATIO,
                "validation": VAL_RATIO,
                "test": TEST_RATIO,
            },
            "random_seed":
                self.random_seed,
            "label_mapping": {
                str(i): str(name)
                for i, name
                in enumerate(
                    self.label_encoder.classes_
                )
            },
            "training_class_counts":
                train_class_counts.tolist(),
            "feature_scaler":
                "MinMaxScaler fitted on training nodes only",
            "graph_type":
                "Undirected k-NN graph with self-loops",
        }

        with open(
            metadata_path,
            "w",
            encoding="utf-8",
        ) as file:
            json.dump(
                metadata,
                file,
                indent=4,
            )
        print(
            "\n"
            + "=" * 70
        )
        print(
            "GNN-COSBO DATASET "
            "SUCCESSFULLY GENERATED"
        )
        print(
            "=" * 70
        )
        print(
            f"\nGraph saved to:\n"
            f"{graph_path}"
        )
        print(
            f"\nDGL metadata saved to:\n"
            f"{info_path}"
        )
        print(
            f"\nMetadata saved to:\n"
            f"{metadata_path}"
        )
  
    def __getitem__(self, i):

        if i != 0:
            raise IndexError(
                "This dataset contains one graph."
            )
        return self.graph
    def __len__(self):
        return 1
    @property
    def num_classes(self):
        return self._num_classes
def verify_dataset(dataset):
    graph = dataset[0]
    print(
        "\n"
        + "=" * 70
    )
    print(
        "VERIFYING GENERATED GRAPH"
    )
    print(
        "=" * 70
    )
    print(
        f"Graph:\n{graph}"
    )
    print(
        f"\nFeature tensor shape: "
        f"{graph.ndata['feat'].shape}"
    )
    print(
        f"Label tensor shape: "
        f"{graph.ndata['label'].shape}"
    )
    print(
        f"Training nodes: "
        f"{graph.ndata['train_mask'].sum().item()}"
    )
    print(
        f"Validation nodes: "
        f"{graph.ndata['val_mask'].sum().item()}"
    )
    print(
        f"Test nodes: "
        f"{graph.ndata['test_mask'].sum().item()}"
    )
    train_mask = graph.ndata[
        "train_mask"
    ]
    val_mask = graph.ndata[
        "val_mask"
    ]
    test_mask = graph.ndata[
        "test_mask"
    ]
    assert not torch.any(
        train_mask & val_mask
    )
    assert not torch.any(
        train_mask & test_mask
    )
    assert not torch.any(
        val_mask & test_mask
    )
    assert torch.all(
        train_mask
        | val_mask
        | test_mask
    )
    assert torch.isfinite(
        graph.ndata["feat"]
    ).all()
    print(
        "\nAll preprocessing checks passed."
    )
if __name__ == "__main__":
    set_seed(
        RANDOM_SEED
    )
    dataset = GNNCOSBODataset(
        csv_path=os.path.join(
            DATA_DIR,
            CSV_FILE,
        ),
        k=KNN_K,
        random_seed=RANDOM_SEED,
    )
    verify_dataset(
        dataset
    )
